# Хостинг Reg.ru (Apache). Сайт — статический, кладите файлы в www / public_html.

DirectoryIndex index.html
Options -Indexes -MultiViews
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType audio/mp4 .m4a
AddType font/woff2 .woff2
AddType image/webp .webp

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Единый канонический адрес: HTTPS без www.
	RewriteCond %{HTTP_HOST} ^www\.todobichig\.ru$ [NC]
	RewriteRule ^ https://todobichig.ru%{REQUEST_URI} [L,R=301]

	# На Reg.ru HTTPS может завершаться на nginx перед Apache.
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
	RewriteRule ^ https://todobichig.ru%{REQUEST_URI} [L,R=301]

	# Старые динамические адреса больше не используются.
	RewriteRule ^robots\.php$ /robots.txt [L,R=301]
	RewriteRule ^sitemap\.php$ /sitemap.xml [L,R=301]

	RewriteRule (^|/)\.git - [F,L]
</IfModule>

ErrorDocument 404 /404.html

<FilesMatch "^(writer-edit|writer-strokes-edit)\.html$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order deny,allow
		Deny from all
	</IfModule>
</FilesMatch>

<IfModule mod_headers.c>
	<Files "sw.js">
		Header set Cache-Control "no-cache"
	</Files>
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType text/css "access plus 7 days"
	ExpiresByType application/javascript "access plus 7 days"
	ExpiresByType application/manifest+json "access plus 1 day"
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType audio/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
